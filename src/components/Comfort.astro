---
// "What's inside": one bedroom photo with a guest's own words beside a plain
// list of what every apartment has, read top to bottom. It arrives in one
// gentle sequence: the photo settles, the words rise, the list follows (motion.ts).
import { Image } from 'astro:assets';
import bed from '../assets/photos/a1-bed-hd.jpg';
import Icon, { type IconName } from './Icon.astro';
import { getDict } from '../i18n';
import type { Lang } from '../data/apartments';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).comfort;
// One icon per amenity, in dictionary order.
const ICONS: readonly IconName[] = ['broom', 'wifi', 'pot', 'shower', 'moon', 'handshake', 'briefcase', 'qr'];
---
<section id="comfort" class="comfort" aria-labelledby="comfort-title">
  <header class="section-head section-head--sky">
    <h2 id="comfort-title" class="section-title" data-split>{t.title}</h2>
  </header>

  <div class="amenities" data-amenities>
    <figure class="amenities__photo">
      {/* A 2400 px original. The tall column crops a landscape photo by its
          height, so the browser needs ~1.4x the height in width: hence sizes
          wider than the column itself (75vw desktop, 135vw for the phone square). */}
      <Image
        src={bed}
        alt={lang === 'ru' ? 'Спальня со свежим бельём' : 'Таза төсек-орыны бар жатын бөлме'}
        widths={[640, 960, 1440, 2000]}
        sizes="(min-width: 1000px) 75vw, 135vw"
        quality={90}
        data-amenities-img
      />
      <figcaption class="amenities__quote" data-amenities-quote>
        <blockquote lang="ru"><p>«{t.quote}»</p></blockquote>
        <span>{t.quoteAuthor}</span>
      </figcaption>
    </figure>
    <ul class="amenities__list">
      {t.patches.map((item, i) => (
        <li class="amenity" data-amenity>
          <span class="amenity__icon"><Icon name={ICONS[i] ?? 'broom'} size={26} /></span>
          <h3 class="amenity__title">{item.t}</h3>
          <p class="amenity__text">{item.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
