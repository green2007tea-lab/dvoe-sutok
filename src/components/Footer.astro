---
// The day has come full circle. Phones keep a bottom bar in thumb reach:
// WhatsApp and a round call button. Desktop hides it.
import WaLink from './WaLink.astro';
import Icon from './Icon.astro';
import { getDict } from '../i18n';
import { DEMO, PHONE } from '../data/site';
import type { Lang } from '../data/apartments';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <p class="footer__wrap" data-split>{t.footer.wrap}</p>
  <div class="footer__row">
    <p>{t.footer.tagline}</p>
    <a href={PHONE.tel}>{PHONE.display}</a>
    <p class="footer__copy">© {year} «Двое суток»</p>
    {DEMO && <p>{t.apartments.demoPhotos}: stocksnap.io, CC0</p>}
  </div>
</footer>

<div class="bottom-bar">
  <WaLink lang={lang} block />
  <a class="bottom-bar__call" href={PHONE.tel} aria-label={`${t.cta.callShort} ${PHONE.display}`}>
    <Icon name="phone" size={24} />
  </a>
</div>
