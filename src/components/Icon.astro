---
// Inline Phosphor icons (one family, one weight per use). No hand-drawn glyphs.
import whatsapp from '@phosphor-icons/core/assets/fill/whatsapp-logo-fill.svg?raw';
import key from '@phosphor-icons/core/assets/fill/key-fill.svg?raw';
import star from '@phosphor-icons/core/assets/fill/star-fill.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import arrowLeft from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import telegram from '@phosphor-icons/core/assets/regular/telegram-logo.svg?raw';
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import chat from '@phosphor-icons/core/assets/fill/chat-circle-dots-fill.svg?raw';
import images from '@phosphor-icons/core/assets/fill/images-fill.svg?raw';
// «What's inside»: one regular-weight icon per amenity
import broom from '@phosphor-icons/core/assets/regular/broom.svg?raw';
import wifi from '@phosphor-icons/core/assets/regular/wifi-high.svg?raw';
import pot from '@phosphor-icons/core/assets/regular/cooking-pot.svg?raw';
import shower from '@phosphor-icons/core/assets/regular/shower.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon-stars.svg?raw';
import handshake from '@phosphor-icons/core/assets/regular/handshake.svg?raw';
import briefcase from '@phosphor-icons/core/assets/regular/briefcase.svg?raw';
import qr from '@phosphor-icons/core/assets/regular/qr-code.svg?raw';

const ICONS = {
  whatsapp, key, star, phone, arrowLeft, arrowRight, telegram, mapPin, chat, images,
  broom, wifi, pot, shower, moon, handshake, briefcase, qr,
} as const;
export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = 'icon' } = Astro.props;
const svg = ICONS[name].replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="${className}" `,
);
---
<Fragment set:html={svg} />
